# ==================================================
# QueueLess Environment Variables
# ==================================================

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/queueless"

# JWT Secret (change in production!)
JWT_SECRET="queueless-dev-secret-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
API_PORT=4000
API_HOST=localhost
NODE_ENV=development

# Payment Gateway (connect real provider in production)
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Printer (optional)
PRINTER_ENABLED=false
PRINTER_TYPE=browser
# THERMAL_PRINTER_IP=
# THERMAL_PRINTER_PORT=
